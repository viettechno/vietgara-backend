# Apply db/migrations on startup; set to false when migrations are managed externally
RUN_MIGRATIONS=true

# Database Info
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PASSWORD_URLENCODED=password
POSTGRES_DB=testdb
POSTGRES_PORT=5432
DATABASE_URL=postgres://user:password@127.0.0.1:5432/testdb?sslmode=disable

# JWT Token Info
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=720h
# Dev-only key. Replace with a generated secret (e.g. openssl rand -hex 32) before staging.
JWT_SIGNING_KEY=cd56d1135149a29752cf09e6161b57099504a809fd2a4a318f65df4c4d9ee6d6

# grpc server info
GRPC_PORT=50051
HTTP_PORT=8080

# Google OAuth 2.0 authorization-code login.
# Add http://localhost:8000/api/auth/google/callback to the Google OAuth client
# authorized redirect URIs. Keep the client secret out of source control.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:8000

# Kong local ports. The web admin is available through KONG_PROXY_PORT.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
