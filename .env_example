# Apply db/migrations on startup; set to false when migrations are managed externally
RUN_MIGRATIONS=true

# Database (docker-compose): the owner runs migrations, the backend connects
# as APP_DB_USER, a login in the vietgara_app role (no BYPASSRLS).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PASSWORD_URLENCODED=password
POSTGRES_DB=testdb
POSTGRES_PORT=5432
APP_DB_USER=vietgara_local
APP_DB_PASSWORD=vietgara_local
# `make run` (outside Docker):
MIGRATION_DATABASE_URL=postgres://user:password@127.0.0.1:5432/testdb?sslmode=disable
DATABASE_URL=postgres://vietgara_local:vietgara_local@127.0.0.1:5432/testdb?sslmode=disable

# JWT Token Info
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=720h
# Dev-only key. Replace with a generated secret (e.g. openssl rand -hex 32) before staging.
JWT_SIGNING_KEY=cd56d1135149a29752cf09e6161b57099504a809fd2a4a318f65df4c4d9ee6d6

# grpc server info
GRPC_PORT=50051
HTTP_PORT=8080

# Google OAuth 2.0 authorization-code login. The redirect URI is
# APP_BASE_URL + /api/v1/auth/google/callback: add it to the Google OAuth
# client's authorized redirect URIs. Keep the client secret out of source control.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in from the mobile apps (Customer App, Release 2.4): the
# comma-separated OAuth client IDs their ID tokens are issued to -- the
# Android app's "web/server" client and the iOS client. Empty disables
# POST /api/v1/auth/google/id-token.
GOOGLE_MOBILE_CLIENT_IDS=
# Public URL of this deployment (local, staging or production): the web admin
# origin, the Google OAuth callback host and the base of e-mailed links.
APP_BASE_URL=http://localhost:8000

# Comma-separated e-mails of platform admins (plan management, FR-LIC-05).
PLATFORM_ADMIN_EMAILS=admin@viettechno.com

# Redis (Memorystore): sessions, OTPs, entitlement cache, transaction
# counters. Empty = in-memory (single instance only).
REDIS_ADDR=
REDIS_PASSWORD=
ENTITLEMENT_CACHE_TTL=5m

# Kafka (ADR-004). Empty KAFKA_BROKERS = events are delivered in-process.
KAFKA_BROKERS=
KAFKA_TOPIC_PREFIX=vietgara
KAFKA_CONSUMER_GROUP=vietgara-backend
KAFKA_EXTERNAL_PORT=29092
OUTBOX_RELAY_INTERVAL=2s
LICENSE_EXPIRY_JOB_INTERVAL=1h

# E-mail: smtp (Mailpit locally / in tests) or mailjet (staging, production).
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=support@viettechno.com
MAIL_FROM_NAME=VietGara
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILPIT_UI_PORT=8025

# Uploaded files (garage logos): local (local, staging) or gcs (production).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.data/uploads
STORAGE_PUBLIC_BASE_URL=
STORAGE_GCS_BUCKET=

# Kong local ports. The garage web admin is http://localhost:KONG_PROXY_PORT;
# the platform admin is http://admin.localhost:KONG_PROXY_PORT.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
